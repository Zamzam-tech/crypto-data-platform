FROM apache/airflow:2.8.1-python3.10

USER root

RUN apt-get update && apt-get install -y git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER airflow

RUN pip install --no-cache-dir --default-timeout=300 \
    pandas \
    google-cloud-bigquery \
    pyarrow \
    dbt-bigquery \
    kafka-python
